# X (Twitter) API v2 Bearer Token
# Retrieve from Developer Console (developer.x.com) under "Keys and tokens"
X_BEARER_TOKEN=your_x_bearer_token_here

# Optional fallback:
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ---------------------------------------------------------------------------
# Remote / HTTP deployment (optional — ignored by the default stdio transport)
# ---------------------------------------------------------------------------
# X_SEARCH_TRANSPORT=both          # stdio | sse | streamable-http | both
# X_SEARCH_HOST=127.0.0.1
# X_SEARCH_PORT=8091
# X_SEARCH_PATH=/mcp
# X_SEARCH_STATELESS=1             # omit Mcp-Session-Id; friendlier behind a proxy
# X_SEARCH_HTTP_TOKEN=             # require Authorization: Bearer <token>; leave
#                                  # unset to disable, never set it to empty