# X (Twitter) API v2 Bearer Token
# Retrieve from Developer Console (developer.x.com) under "Keys and tokens"
X_BEARER_TOKEN=your_x_bearer_token_here

# Optional fallback:
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ---------------------------------------------------------------------------
# Remote / HTTP deployment (optional — ignored by the default stdio transport)
# ---------------------------------------------------------------------------
# X_SEARCH_TRANSPORT=both          # stdio | sse | streamable-http | both
# X_SEARCH_HOST=127.0.0.1
# X_SEARCH_PORT=8091
# X_SEARCH_PATH=/mcp
# X_SEARCH_STATELESS=1             # omit Mcp-Session-Id; friendlier behind a proxy

# Static bearer auth (blunt; incompatible with the OAuth layer below).
# Leave it unset to disable, never set it to empty.
# X_SEARCH_HTTP_TOKEN=

# ---------------------------------------------------------------------------
# OAuth 2.1 authorization server (required for Google Gemini Spark)
# ---------------------------------------------------------------------------
# Setting the public origin switches the server into OAuth mode: clients must
# complete an authorization-code flow before they can call any tool. Gemini
# Spark's custom apps are OAuth-only, so this is what makes the endpoint valid.
#
# X_SEARCH_PUBLIC_URL=https://mcp.example.com   # the HTTPS URL clients reach
# X_SEARCH_OAUTH_STORE=~/.config/xsearch-oauth.json
# X_SEARCH_OAUTH_SUBJECT=owner                  # resource owner stamped on tokens
# X_SEARCH_OAUTH_TOKEN_AUTH_METHOD=client_secret_post
#   # client_secret_post (default) or client_secret_basic. Only affects the
#   # pre-registered fallback client; dynamically registered clients are public.
# X_SEARCH_OAUTH_DYNAMIC_REGISTRATION=1
#   # RFC 7591 dynamic client registration. On by default: Gemini Spark
#   # self-registers as a public client and never uses the Advanced fields.
# X_SEARCH_OAUTH_ALLOWED_REDIRECT_ORIGINS=oauth-redirect.googleusercontent.com,google.com
#   # Origins a dynamically registered client's redirect_uris must be on. This is
#   # what stops open registration from being an open door.
# X_SEARCH_OAUTH_CLIENT_ID=                     # optional: pin instead of generating
# X_SEARCH_OAUTH_CLIENT_SECRET=                 # optional: pin instead of generating